rules_version = '2';

// Each signed-in user can read and write only their own shop:
// shops/{their uid}/customers, items and transactions.
service cloud.firestore {
  match /databases/{database}/documents {
    match /shops/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
